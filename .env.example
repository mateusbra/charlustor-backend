DATABASE_URL="postgresql://charlustor:charlustor@localhost:5432/charlustor?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# JWT — gere segredos aleatórios próprios (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES="30d"

# OAuth — opcional em dev; sem credenciais, o provedor correspondente fica desabilitado
OAUTH_CALLBACK_BASE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# E-mail (recuperação de senha) — em dev aponta para o serviço maildev do docker-compose
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="no-reply@charlustor.local"
